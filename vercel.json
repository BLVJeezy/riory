{
  "redirects": [
    {
      "source": "/klantportaal",
      "destination": "https://werkbonnen.riory.be/portaal/inloggen",
      "permanent": false
    },
    {
      "source": "/klantportaal/:path*",
      "destination": "https://werkbonnen.riory.be/portaal/inloggen",
      "permanent": false
    },
    {
      "source": "/klantenportaal",
      "destination": "https://werkbonnen.riory.be/portaal/inloggen",
      "permanent": false
    },
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/mail/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noimageindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
